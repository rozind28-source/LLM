# LLM Failover MVP — Environment Configuration
# Copy this file to .env and fill in your actual values.

# Path to the keys.json file (contains your API keys)
KEYS_PATH=./keys.json

# Path to the generated pool-config.json
POOL_CONFIG_PATH=./pool-config.json

# URL of the free LLM APIs catalog
CATALOG_URL=https://raw.githubusercontent.com/mnfst/awesome-free-llm-apis/main/data.json

# Path to the pool state file (cooldowns, error counts)
POOL_STATE_PATH=./llm-pool-state.json

# Log level: debug | info | warn | error
LOG_LEVEL=info

# HTTP server port for the runtime
PORT=3001

# Hot-reload polling interval in milliseconds
HOT_RELOAD_INTERVAL_MS=5000
